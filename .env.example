# ============================================================
# Smart Workplace Safety Intelligence Platform
# Environment Configuration
# ============================================================
# Copy this file to .env and fill in the values

# --- Application ---
APP_NAME=SafetyIntelligence
APP_ENV=development
DEBUG=true

# --- Backend Server ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# --- Frontend ---
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000

# --- Database ---
# SQLite (default for development)
DATABASE_URL=sqlite:///./safety_intelligence.db
# PostgreSQL (production)
# DATABASE_URL=postgresql://user:password@localhost:5432/safety_intelligence

# --- Detection Engine ---
MODEL_PATH=ml/models/yolov8n.pt
MODEL_CONFIDENCE_THRESHOLD=0.5
MODEL_IOU_THRESHOLD=0.45
MODEL_INPUT_SIZE=640
MODEL_DEVICE=auto

# --- Video Processing ---
MAX_UPLOAD_SIZE_MB=500
UPLOAD_DIR=backend/uploads
SNAPSHOT_DIR=backend/snapshots
VIDEO_FPS_LIMIT=30
FRAME_SKIP=0

# --- Safety Rules ---
PPE_CONFIDENCE_THRESHOLD=0.45
OBSTACLE_PERSISTENCE_FRAMES=10
OBSTACLE_ZONE_OVERLAP_THRESHOLD=0.3
EVENT_COOLDOWN_SECONDS=30

# --- WebSocket ---
WS_FRAME_QUALITY=70
WS_MAX_CONNECTIONS=10

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Logging ---
LOG_LEVEL=INFO
